# Copy to .env in the project root. start.sh loads it on each restart.
# Shell syntax: put passwords containing spaces or $ in single quotes.
PARKGO_REGISTRATION_MODE=verified
PARKGO_SMTP_HOST=smtp.example.com
PARKGO_SMTP_PORT=587
PARKGO_SMTP_SECURITY=starttls
PARKGO_SMTP_FROM=parkgo@example.com
PARKGO_SMTP_USER=parkgo@example.com
PARKGO_SMTP_PASSWORD='REPLACE_WITH_PROVIDER_APP_PASSWORD'
PARKGO_PUBLIC_URL=https://msi5050.tail6a914d.ts.net

# Providers using port 465 need PARKGO_SMTP_SECURITY=ssl.
# For a classroom demo without email, explicitly set:
# PARKGO_REGISTRATION_MODE=demo
# Demo mode does NOT verify ownership of university email addresses.
